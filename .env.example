JWT_SECRET=replace-with-output-of: python -c "import secrets;print(secrets.token_hex(32))"
FRONTEND_ORIGIN=http://localhost:3000
FLASK_DEBUG=1

# Optional -- defaults shown. See README's Environment variables table.
# VECTOR_BACKEND=local
# OPENSEARCH_URL=http://localhost:9200
# MATCH_THRESHOLD=0.5

# /api/ask's LLM backend: "anthropic" (default, needs ANTHROPIC_API_KEY,
# a paid API key -- NOT a claude.ai Pro subscription) or "ollama" (free,
# runs locally -- see README's "Running /api/ask locally with Ollama").
# LLM_BACKEND=anthropic
# ANTHROPIC_API_KEY=
# OLLAMA_MODEL=llama3.2
